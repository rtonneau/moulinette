import { Button, ComboBox, LineEdit, CheckBox, TextEdit, Spinner, Palette, ScrollView } from "std-widgets.slint";
import { Panel } from "components/panel.slint";

// One interactive `chart::LineChart`-backed view: a `TouchArea` reporting
// resize/scroll/pointer events through `resized`/`zoom`/`pan`/`hover`,
// showing `chart-image` plus a hover marker and tooltip near the cursor,
// shared by the rate-vs-time, spectrum-with-ROI-bands and violin
// (time-window density) charts, which otherwise only differ in which
// Rust-side `chart::LineChart` backs them.
component InteractiveChart inherits TouchArea {
    in property <image> chart-image;
    in property <string> chart-tooltip;
    in property <float> marker-x;
    in property <float> marker-y;
    callback resized(float, float);
    // x, y, wheel delta-y, width, height.
    callback zoom(float, float, float, float, float);
    // from-x, from-y, to-x, to-y, width, height.
    callback pan(float, float, float, float, float, float);
    // x, y, width, height.
    callback hover(float, float, float, float);
    height: 380px;
    accessible-role: image;
    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.crosshair;
    property <length> drag-x;
    property <length> drag-y;
    init => { self.resized(self.width / 1px, self.height / 1px); }
    changed width => { self.resized(self.width / 1px, self.height / 1px); }
    changed height => { self.resized(self.width / 1px, self.height / 1px); }
    scroll-event(event) => {
        self.zoom(self.mouse-x / 1px, self.mouse-y / 1px, event.delta-y / 1px, self.width / 1px, self.height / 1px);
        accept
    }
    pointer-event(event) => {
        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
            self.drag-x = self.mouse-x;
            self.drag-y = self.mouse-y;
        } else if event.kind == PointerEventKind.move {
            if self.pressed {
                self.pan(self.drag-x / 1px, self.drag-y / 1px, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                self.drag-x = self.mouse-x;
                self.drag-y = self.mouse-y;
            } else {
                self.hover(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
            }
        }
    }
    Image { x: 0; y: 0; width: parent.width; height: parent.height; source: root.chart-image; image-fit: fill; }
    if root.has-hover && !root.pressed && root.chart-tooltip != "": Rectangle {
        x: root.marker-x * 1px - 5px;
        y: root.marker-y * 1px - 5px;
        width: 10px; height: 10px; border-radius: 5px;
        border-width: 2px; border-color: #17243b;
    }
    if root.has-hover && !root.pressed && root.chart-tooltip != "": Rectangle {
        // Near the cursor, flipped left/up when it would leave the chart.
        x: root.mouse-x + 14px + self.width > root.width ? max(0px, root.mouse-x - 8px - self.width) : root.mouse-x + 14px;
        y: root.mouse-y + 18px + self.height > root.height ? max(0px, root.mouse-y - 8px - self.height) : root.mouse-y + 18px;
        width: tooltip.preferred-width + 12px;
        height: tooltip.preferred-height + 8px;
        background: #ffffffee; border-width: 1px; border-color: #17243b; border-radius: 4px;
        tooltip := Text { x: 6px; y: 4px; text: root.chart-tooltip; color: #17243b; font-size: 12px; }
    }
}

// One editable ROI row of the list-mode panel; `unit` indexes `roi-units`.
export struct RoiRow {
    name: string,
    adc: string,
    low: string,
    high: string,
    unit: int,
}

// One editable violin time window of the list-mode panel, in seconds.
export struct TimeWindowRow {
    start-s: string,
    end-s: string,
}

export component MainWindow inherits Window {
    title: "Moulinette · Ion Beam Analysis";
    preferred-width: 1080px; preferred-height: 820px;
    min-width: 760px; min-height: 300px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    in-out property <bool> dark: false;
    in-out property <bool> busy;
    in property <bool> loaded;
    in property <bool> has-results;
    in property <string> filename: "No measurement selected";
    in property <string> input-path;
    in-out property <string> output-path;
    in property <[string]> formats;
    in property <[string]> spectra;
    in-out property <int> mode;
    in-out property <int> spectrum;
    in-out property <string> first-channel: "0";
    in-out property <string> last-channel;
    // Charge normalization (ticket 08): one entry per loaded spectrum,
    // used to pick the monitor ADC/spectrum whose own total counts stand
    // in for integrated beam charge (ADR 0002). Shown only when `mode`
    // selects the "Charge-normalized (µC)" entry of `formats`
    // (`gui_state::MODES`'s 9th/last entry, index 8).
    in property <[string]> monitor-adcs;
    in-out property <int> monitor-adc;
    in-out property <string> counts-per-uc;
    // Charge-axis chart (ticket 09): an opt-in extra in-window chart on
    // the `.lst` Analyze panel, plotting each ROI's existing time-binned
    // rate against a monitor ADC's running cumulative count (or implied
    // µC, when calibrated) instead of elapsed time. Reuses `ChargeCalibration`/
    // `charge_calibration` (ticket 08); never written to a file, unlike
    // `monitor-adcs`/`monitor-adc`/`counts-per-uc` above, which still
    // belong to the Convert screen's charge-normalized output format.
    in-out property <bool> charge-axis-enabled;
    in property <[string]> charge-axis-monitor-adcs;
    in-out property <int> charge-axis-monitor-adc;
    in-out property <string> charge-axis-counts-per-uc;
    in property <string> description;
    in property <string> inspection;
    in property <string> preview;
    in property <string> results;
    in property <string> warnings;
    in property <string> status: "Open an MPA measurement or list-mode file to begin.";
    in property <bool> error;
    in property <string> drop-hint;
    // List-mode (.lst) analysis panel, shown instead of the converter panel.
    in property <bool> list-mode;
    // Top-level navigation: 0 = home, 1 = convert, 2 = analyze. This only
    // decides whether the converter/list-mode panel is reachable; which
    // panel variant renders is still decided by `list-mode` alone, since a
    // loaded file's extension does not change when the screen changes.
    in-out property <int> screen: 0;
    // Interactive spectrum-with-ROI-bands chart for the `.mpa` Analyze
    // panel (Ticket 7 upgrade of Ticket 5's static placeholder), rendered
    // by `chart::LineChart` (Rust) at the chart area's size, exactly like
    // `rate-chart` below: the callbacks report cursor positions in the
    // chart area's own logical coordinates plus its current width/height;
    // Rust maps them to buffer pixels, updates the view range and
    // re-renders `spectrum-chart`. ROI bands are redrawn clipped to the
    // current view on every render, so they stay shaded through pan/zoom.
    in property <image> spectrum-chart;
    in property <bool> spectrum-chart-ready;
    in property <string> spectrum-chart-tooltip;
    in property <float> spectrum-chart-marker-x;
    in property <float> spectrum-chart-marker-y;
    callback spectrum-chart-resized(float, float);
    callback spectrum-chart-zoom(float, float, float, float, float);
    callback spectrum-chart-pan(float, float, float, float, float, float);
    callback spectrum-chart-hover(float, float, float, float);
    callback spectrum-chart-reset();
    // Interactive rate-vs-time chart of the last `.lst` analysis run,
    // rendered by `chart::LineChart` (Rust) at the chart area's size. The
    // callbacks report cursor positions in the chart area's own logical
    // coordinates plus its current width/height; Rust maps them to buffer
    // pixels, updates the view range and re-renders `rate-chart`.
    in property <image> rate-chart;
    in property <bool> rate-chart-ready;
    // Nearest-point tooltip text ("" hides it) and that point's position
    // in the chart area's logical coordinates.
    in property <string> rate-chart-tooltip;
    in property <float> rate-chart-marker-x;
    in property <float> rate-chart-marker-y;
    callback rate-chart-resized(float, float);
    // x, y, wheel delta-y, width, height.
    callback rate-chart-zoom(float, float, float, float, float);
    // from-x, from-y, to-x, to-y, width, height.
    callback rate-chart-pan(float, float, float, float, float, float);
    // x, y, width, height.
    callback rate-chart-hover(float, float, float, float);
    callback rate-chart-reset();
    // Interactive per-ROI/time-window density ("violin") chart of the
    // last `.lst` analysis run (shown only once at least one time window
    // is configured and the run has completed), same wiring as
    // `rate-chart` above.
    in property <image> violin-chart;
    in property <bool> violin-chart-ready;
    in property <string> violin-chart-tooltip;
    in property <float> violin-chart-marker-x;
    in property <float> violin-chart-marker-y;
    callback violin-chart-resized(float, float);
    callback violin-chart-zoom(float, float, float, float, float);
    callback violin-chart-pan(float, float, float, float, float, float);
    callback violin-chart-hover(float, float, float, float);
    callback violin-chart-reset();
    // Interactive charge-axis chart (ticket 09), shown only once "Enable
    // charge-axis chart" is checked and an analysis run has completed;
    // same wiring as `violin-chart` above.
    in property <image> charge-chart;
    in property <bool> charge-chart-ready;
    in property <string> charge-chart-tooltip;
    in property <float> charge-chart-marker-x;
    in property <float> charge-chart-marker-y;
    callback charge-chart-resized(float, float);
    callback charge-chart-zoom(float, float, float, float, float);
    callback charge-chart-pan(float, float, float, float, float, float);
    callback charge-chart-hover(float, float, float, float);
    callback charge-chart-reset();
    callback go-home();
    callback pick-convert();
    callback pick-analyze();
    in property <[string]> roi-units;
    in-out property <[RoiRow]> rois;
    in-out property <[TimeWindowRow]> time-windows;
    in-out property <string> bin-width: "15000";
    callback add-roi();
    callback remove-roi(int);
    callback add-time-window();
    callback remove-time-window(int);
    callback analyze();
    callback open-input();
    callback input-contains(float, float) -> bool;
    input-contains(x, y) => {
        return x >= input-panel.absolute-position.x / 1px && x < (input-panel.absolute-position.x + input-panel.width) / 1px
            && y >= input-panel.absolute-position.y / 1px && y < (input-panel.absolute-position.y + input-panel.height) / 1px
            && y >= 0 && y < root.height / 1px;
    }
    callback choose-output();
    callback settings-changed();
    callback convert();
    callback open-directory();
    background: root.dark ? #151c28 : #f3f6fb;
    property <color> ink: root.dark ? #edf2fa : #17243b;
    property <color> muted: root.dark ? #b2bfd2 : #52637a;
    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    ScrollView {
      horizontal-scrollbar-policy: always-off;
      VerticalLayout {
        padding: 24px; spacing: 16px;
        HorizontalLayout {
            VerticalLayout {
                Text { text: "Moulinette"; color: root.ink; font-size: 28px; font-weight: 700; }
                Text { text: "ION BEAM ANALYSIS  /  MEASUREMENT CONVERTER"; color: root.muted; font-size: 12px; }
            }
            if root.screen != 0: Button { text: "← Home"; clicked => { root.go-home(); } }
            CheckBox { text: "Dark theme"; checked <=> root.dark; }
        }
        if root.screen == 0: HorizontalLayout {
            spacing: 16px;
            Panel {
                dark: root.dark;
                VerticalLayout {
                    padding: 24px; spacing: 12px; alignment: center;
                    Text { text: "List-mode analysis"; color: root.ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Inspect .lst list-mode acquisitions: ROI rates and violin plots."; color: root.muted; wrap: word-wrap; horizontal-alignment: center; }
                    Button { text: "Analyze"; primary: true; clicked => { root.pick-analyze(); } }
                }
            }
            Panel {
                dark: root.dark;
                VerticalLayout {
                    padding: 24px; spacing: 12px; alignment: center;
                    Text { text: "Measurement conversion"; color: root.ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Convert .mpa measurements to XY, EY and other legacy formats."; color: root.muted; wrap: word-wrap; horizontal-alignment: center; }
                    Button { text: "Convert"; primary: true; clicked => { root.pick-convert(); } }
                }
            }
        }
        // Always instantiated (never inside an `if`) so `input-contains` can
        // keep referencing it by id; collapsed to zero height and hidden
        // instead of removed when the home screen is showing.
        input-panel := Panel {
            dark: root.dark;
            visible: root.screen != 0;
            max-height: root.screen != 0 ? 100000px : 0px;
            clip: true;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                HorizontalLayout {
                    Text { text: root.filename; color: root.ink; font-weight: 600; overflow: elide; }
                    Button { text: "Open .mpa/.lst…"; enabled: !root.busy; clicked => { root.open-input(); } }
                }
                Text { text: root.drop-hint != "" ? root.drop-hint : root.busy ? "Working — file drops are unavailable." : "Drop one .mpa or .lst file here, or use Open."; color: root.muted; }
                Text { text: root.input-path; color: root.muted; overflow: elide; }
            }
        }
        if root.screen != 0 && root.list-mode: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: "List-mode inspection"; color: root.ink; font-size: 18px; font-weight: 600; }
                Text { text: "Event summary and ADC calibration from the .lst header"; color: root.muted; wrap: word-wrap; }
                TextEdit { text: root.inspection; read-only: true; min-height: 80px; max-height: 160px; }
            }
        }
        if root.screen != 0 && root.list-mode: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: "List-mode analysis"; color: root.ink; font-size: 18px; font-weight: 600; }
                Text { text: "Rate vs. time per ROI, written as CSV and PNG. Time windows add one violin plot per ROI."; color: root.muted; wrap: word-wrap; }
                Text { text: "Regions of interest · name, ADC (1–8), low and high bounds, unit"; color: root.muted; }
                for roi[index] in root.rois: HorizontalLayout {
                    spacing: 8px;
                    LineEdit { text <=> roi.name; placeholder-text: "Name"; min-width: 80px; horizontal-stretch: 2; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.adc; placeholder-text: "ADC"; min-width: 50px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.low; placeholder-text: "Low"; min-width: 60px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.high; placeholder-text: "High"; min-width: 60px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    ComboBox { model: root.roi-units; current-index <=> roi.unit; min-width: 90px; horizontal-stretch: 0; enabled: !root.busy; selected => { root.settings-changed(); } }
                    Button { text: "Remove"; enabled: !root.busy; clicked => { root.remove-roi(index); } }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Add ROI"; enabled: !root.busy; clicked => { root.add-roi(); } }
                }
                Text { text: "Time-bin width (ms)"; color: root.muted; }
                LineEdit { text <=> root.bin-width; enabled: !root.busy; edited => { root.settings-changed(); } }
                Text { text: "Violin time windows (s) · optional, start inclusive, end exclusive"; color: root.muted; }
                for period[index] in root.time-windows: HorizontalLayout {
                    spacing: 8px;
                    LineEdit { text <=> period.start-s; placeholder-text: "Start (s)"; min-width: 80px; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> period.end-s; placeholder-text: "End (s)"; min-width: 80px; enabled: !root.busy; edited => { root.settings-changed(); } }
                    Button { text: "Remove"; enabled: !root.busy; clicked => { root.remove-time-window(index); } }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Add time window"; enabled: !root.busy; clicked => { root.add-time-window(); } }
                }
                // Charge-axis chart (ticket 09): opt-in, in-window only.
                // Reuses `ChargeCalibration`/`charge_calibration` (ticket
                // 08); never changes the CSV/PNG files above.
                CheckBox { text: "Enable charge-axis chart"; checked <=> root.charge-axis-enabled; enabled: !root.busy; toggled => { root.settings-changed(); } }
                if root.charge-axis-enabled: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Plots each ROI's rate against a monitor ADC's running count (or implied µC) instead of time, in-window only."; color: root.muted; wrap: word-wrap; font-size: 12px; }
                    Text { text: "Monitor ADC"; color: root.muted; }
                    ComboBox { model: root.charge-axis-monitor-adcs; current-index <=> root.charge-axis-monitor-adc; enabled: root.loaded && !root.busy; selected => { root.settings-changed(); } }
                    Text { text: "Counts per µC (optional)"; color: root.muted; }
                    LineEdit { text <=> root.charge-axis-counts-per-uc; placeholder-text: "Leave blank for a dimensionless running count"; enabled: !root.busy; edited => { root.settings-changed(); } }
                }
                Text { text: "Output directory"; color: root.muted; }
                HorizontalLayout {
                    LineEdit { text <=> root.output-path; enabled: !root.busy; edited => { root.settings-changed(); } }
                    Button { text: "Browse…"; enabled: !root.busy; clicked => { root.choose-output(); } }
                }
                Text { text: "Expected files"; color: root.muted; }
                TextEdit { text: root.preview; read-only: true; min-height: 60px; }
                Text { text: "Existing files are never overwritten."; color: root.muted; font-size: 12px; }
            }
        }
        // In-window view of the last list-mode run's rate-vs-time series.
        // Zooming/panning only changes this view, never the written files.
        if root.screen != 0 && root.list-mode && root.rate-chart-ready: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                HorizontalLayout {
                    Text { text: "Rate vs. time"; color: root.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                    Button { text: "Reset view"; clicked => { root.rate-chart-reset(); } }
                }
                Text { text: "Scroll to zoom around the cursor (over an axis to zoom that axis only), drag to pan, hover for a point's exact values."; color: root.muted; wrap: word-wrap; font-size: 12px; }
                rate-chart-area := TouchArea {
                    height: 380px;
                    accessible-role: image;
                    accessible-label: "Rate vs. time chart";
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.crosshair;
                    property <length> drag-x;
                    property <length> drag-y;
                    init => { root.rate-chart-resized(self.width / 1px, self.height / 1px); }
                    changed width => { root.rate-chart-resized(self.width / 1px, self.height / 1px); }
                    changed height => { root.rate-chart-resized(self.width / 1px, self.height / 1px); }
                    scroll-event(event) => {
                        root.rate-chart-zoom(self.mouse-x / 1px, self.mouse-y / 1px, event.delta-y / 1px, self.width / 1px, self.height / 1px);
                        accept
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            self.drag-x = self.mouse-x;
                            self.drag-y = self.mouse-y;
                        } else if event.kind == PointerEventKind.move {
                            if self.pressed {
                                root.rate-chart-pan(self.drag-x / 1px, self.drag-y / 1px, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                                self.drag-x = self.mouse-x;
                                self.drag-y = self.mouse-y;
                            } else {
                                root.rate-chart-hover(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                            }
                        }
                    }
                    Image { x: 0; y: 0; width: parent.width; height: parent.height; source: root.rate-chart; image-fit: fill; }
                    if rate-chart-area.has-hover && !rate-chart-area.pressed && root.rate-chart-tooltip != "": Rectangle {
                        x: root.rate-chart-marker-x * 1px - 5px;
                        y: root.rate-chart-marker-y * 1px - 5px;
                        width: 10px; height: 10px; border-radius: 5px;
                        border-width: 2px; border-color: #17243b;
                    }
                    if rate-chart-area.has-hover && !rate-chart-area.pressed && root.rate-chart-tooltip != "": Rectangle {
                        // Near the cursor, flipped left/up when it would leave the chart.
                        x: rate-chart-area.mouse-x + 14px + self.width > rate-chart-area.width ? max(0px, rate-chart-area.mouse-x - 8px - self.width) : rate-chart-area.mouse-x + 14px;
                        y: rate-chart-area.mouse-y + 18px + self.height > rate-chart-area.height ? max(0px, rate-chart-area.mouse-y - 8px - self.height) : rate-chart-area.mouse-y + 18px;
                        width: tooltip.preferred-width + 12px;
                        height: tooltip.preferred-height + 8px;
                        background: #ffffffee; border-width: 1px; border-color: #17243b; border-radius: 4px;
                        tooltip := Text { x: 6px; y: 4px; text: root.rate-chart-tooltip; color: #17243b; font-size: 12px; }
                    }
                }
            }
        }
        // In-window view of the last list-mode run's per-ROI/time-window
        // density ("violin") groups, shown once at least one time window
        // is configured and the run has completed; the per-ROI violin PNG
        // files (`plot::violin`, written by `list_mode_write`) are
        // unaffected by zooming/panning this view.
        if root.screen != 0 && root.list-mode && root.violin-chart-ready: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                HorizontalLayout {
                    Text { text: "Rate distribution per time window"; color: root.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                    Button { text: "Reset view"; clicked => { root.violin-chart-reset(); } }
                }
                Text { text: "One density curve per ROI/time-window pair. Scroll to zoom around the cursor, drag to pan, hover for a window's exact density."; color: root.muted; wrap: word-wrap; font-size: 12px; }
                InteractiveChart {
                    accessible-label: "Rate distribution per time window chart";
                    chart-image: root.violin-chart;
                    chart-tooltip: root.violin-chart-tooltip;
                    marker-x: root.violin-chart-marker-x;
                    marker-y: root.violin-chart-marker-y;
                    resized(w, h) => { root.violin-chart-resized(w, h); }
                    zoom(x, y, delta, w, h) => { root.violin-chart-zoom(x, y, delta, w, h); }
                    pan(fx, fy, tx, ty, w, h) => { root.violin-chart-pan(fx, fy, tx, ty, w, h); }
                    hover(x, y, w, h) => { root.violin-chart-hover(x, y, w, h); }
                }
            }
        }
        // In-window charge-axis chart (ticket 09), shown only once "Enable
        // charge-axis chart" is checked and a run has completed; a purely
        // additional view, like `violin-chart` above — the rate-vs-time
        // chart, CSV and PNG outputs are unaffected by this panel.
        if root.screen != 0 && root.list-mode && root.charge-chart-ready: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                HorizontalLayout {
                    Text { text: "Rate vs. charge"; color: root.ink; font-size: 18px; font-weight: 600; vertical-alignment: center; }
                    Button { text: "Reset view"; clicked => { root.charge-chart-reset(); } }
                }
                Text { text: "Scroll to zoom around the cursor (over an axis to zoom that axis only), drag to pan, hover for a point's exact values."; color: root.muted; wrap: word-wrap; font-size: 12px; }
                InteractiveChart {
                    accessible-label: "Rate vs. charge chart";
                    chart-image: root.charge-chart;
                    chart-tooltip: root.charge-chart-tooltip;
                    marker-x: root.charge-chart-marker-x;
                    marker-y: root.charge-chart-marker-y;
                    resized(w, h) => { root.charge-chart-resized(w, h); }
                    zoom(x, y, delta, w, h) => { root.charge-chart-zoom(x, y, delta, w, h); }
                    pan(fx, fy, tx, ty, w, h) => { root.charge-chart-pan(fx, fy, tx, ty, w, h); }
                    hover(x, y, w, h) => { root.charge-chart-hover(x, y, w, h); }
                }
            }
        }
        // Shown on Convert always, and on Analyze until a file is loaded
        // (there is nothing better to show yet); once a `.mpa` file loads
        // on Analyze, the ROI/chart panel below takes over.
        if (root.screen == 1 || (root.screen == 2 && !root.loaded)) && !root.list-mode: HorizontalLayout {
            spacing: 16px;
            Panel {
                dark: root.dark;
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Text { text: "Measurement inspection"; color: root.ink; font-size: 18px; font-weight: 600; }
                    Text { text: "Raw parser metadata · ADC follows DATA occurrence"; color: root.muted; wrap: word-wrap; }
                    TextEdit { text: root.inspection; read-only: true; }
                }
            }
            Panel {
                dark: root.dark;
                VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Text { text: "Conversion settings"; color: root.ink; font-size: 18px; font-weight: 600; }
                    Text { text: "Output format"; color: root.muted; }
                    ComboBox { model: root.formats; current-index <=> root.mode; enabled: !root.busy; selected => { root.settings-changed(); } }
                    Text { text: root.description; color: root.muted; wrap: word-wrap; }
                    Text { text: "Spectra to convert"; color: root.muted; }
                    ComboBox { model: root.spectra; current-index <=> root.spectrum; enabled: root.loaded && !root.busy; selected => { root.settings-changed(); } }
                    if root.mode != 6: HorizontalLayout {
                        VerticalLayout {
                            Text { text: "First channel (0-based)"; color: root.muted; }
                            LineEdit { text <=> root.first-channel; enabled: !root.busy; }
                        }
                        VerticalLayout {
                            Text { text: "Last channel (inclusive)"; color: root.muted; }
                            LineEdit { text <=> root.last-channel; placeholder-text: "Final channel"; enabled: !root.busy; }
                        }
                    }
                    // Charge normalization (ticket 08): collapsed unless
                    // "Charge-normalized (µC)" is the selected output
                    // format (`gui_state::MODES` index 8). Divides each
                    // channel by the chosen monitor ADC/spectrum's total
                    // counts over the run; counts-per-µC is optional and,
                    // left blank, keeps the output a dimensionless ratio.
                    if root.mode == 8: VerticalLayout {
                        spacing: 8px;
                        Text { text: "Charge normalization"; color: root.ink; font-size: 15px; font-weight: 600; }
                        Text { text: "Monitor ADC/spectrum"; color: root.muted; }
                        ComboBox { model: root.monitor-adcs; current-index <=> root.monitor-adc; enabled: root.loaded && !root.busy; selected => { root.settings-changed(); } }
                        Text { text: "Counts per µC (optional)"; color: root.muted; }
                        LineEdit { text <=> root.counts-per-uc; placeholder-text: "Leave blank for a dimensionless ratio"; enabled: !root.busy; edited => { root.settings-changed(); } }
                    }
                    Text { text: "Output directory"; color: root.muted; }
                    HorizontalLayout {
                        LineEdit { text <=> root.output-path; enabled: !root.busy; edited => { root.settings-changed(); } }
                        Button { text: "Browse…"; enabled: !root.busy; clicked => { root.choose-output(); } }
                    }
                    Text { text: "Expected filenames"; color: root.muted; }
                    TextEdit { text: root.preview; read-only: true; min-height: 60px; }
                    Text { text: "Existing files are never overwritten."; color: root.muted; font-size: 12px; }
                }
            }
        }
        // `.mpa` measurement opened on the Analyze screen: an ROI editor
        // (the same row markup as the list-mode panel's, minus the
        // time-window section, which is `.lst`-only) plus an interactive
        // `chart::LineChart` spectrum chart shaded with each ROI's channel
        // range (Ticket 7 upgrade of Ticket 5's static placeholder; ROI
        // bands stay shaded through pan/zoom). Statistics (Ticket 4) are
        // reported in the shared Results panel below, like conversion/
        // list-mode outputs.
        if root.screen == 2 && root.loaded && !root.list-mode: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: "Spectrum ROI analysis"; color: root.ink; font-size: 18px; font-weight: 600; }
                Text { text: "Gross/net counts, centroid and width per ROI, over the loaded spectrum."; color: root.muted; wrap: word-wrap; }
                Text { text: "Regions of interest · name, ADC (1–8), low and high bounds, unit"; color: root.muted; }
                for roi[index] in root.rois: HorizontalLayout {
                    spacing: 8px;
                    LineEdit { text <=> roi.name; placeholder-text: "Name"; min-width: 80px; horizontal-stretch: 2; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.adc; placeholder-text: "ADC"; min-width: 50px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.low; placeholder-text: "Low"; min-width: 60px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.high; placeholder-text: "High"; min-width: 60px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    ComboBox { model: root.roi-units; current-index <=> roi.unit; min-width: 90px; horizontal-stretch: 0; enabled: !root.busy; selected => { root.settings-changed(); } }
                    Button { text: "Remove"; enabled: !root.busy; clicked => { root.remove-roi(index); } }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Add ROI"; enabled: !root.busy; clicked => { root.add-roi(); } }
                }
                Text { text: "Spectrum chart"; color: root.muted; }
                if root.spectrum-chart-ready: VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        Text { text: "Scroll to zoom around the cursor, drag to pan, hover for a channel's exact count."; color: root.muted; wrap: word-wrap; font-size: 12px; horizontal-stretch: 1; }
                        Button { text: "Reset view"; clicked => { root.spectrum-chart-reset(); } }
                    }
                    InteractiveChart {
                        accessible-label: "Spectrum chart";
                        chart-image: root.spectrum-chart;
                        chart-tooltip: root.spectrum-chart-tooltip;
                        marker-x: root.spectrum-chart-marker-x;
                        marker-y: root.spectrum-chart-marker-y;
                        resized(w, h) => { root.spectrum-chart-resized(w, h); }
                        zoom(x, y, delta, w, h) => { root.spectrum-chart-zoom(x, y, delta, w, h); }
                        pan(fx, fy, tx, ty, w, h) => { root.spectrum-chart-pan(fx, fy, tx, ty, w, h); }
                        hover(x, y, w, h) => { root.spectrum-chart-hover(x, y, w, h); }
                    }
                }
            }
        }
        if root.screen != 0: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                HorizontalLayout {
                    Text { text: "Results"; color: root.ink; font-size: 18px; font-weight: 600; }
                    Button { text: "Open output folder"; enabled: root.has-results && !root.busy; clicked => { root.open-directory(); } }
                }
                TextEdit { text: root.results; read-only: true; min-height: 60px; max-height: 100px; }
                Text { text: root.warnings; color: root.muted; wrap: word-wrap; font-size: 12px; }
            }
        }
        if root.screen != 0: HorizontalLayout {
            spacing: 12px;
            if root.busy: Spinner { }
            Text { text: root.status; color: root.error ? (root.dark ? #ffaaaa : #a52626) : root.ink; wrap: word-wrap; }
            Button {
                text: root.busy ? "Working…" : root.list-mode ? "Run list-mode analysis" : root.screen == 2 ? "Compute ROI statistics" : "Convert measurement";
                primary: true; enabled: root.loaded && !root.busy;
                clicked => { if root.list-mode || root.screen == 2 { root.analyze(); } else { root.convert(); } }
            }
        }
    }
    }
}

