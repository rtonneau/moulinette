import { Button, ComboBox, LineEdit, CheckBox, TextEdit, Spinner, Palette, ScrollView } from "std-widgets.slint";
import { Panel } from "components/panel.slint";

// One editable ROI row of the list-mode panel; `unit` indexes `roi-units`.
export struct RoiRow {
    name: string,
    adc: string,
    low: string,
    high: string,
    unit: int,
}

// One editable violin time window of the list-mode panel, in seconds.
export struct TimeWindowRow {
    start-s: string,
    end-s: string,
}

export component MainWindow inherits Window {
    title: "Moulinette · Ion Beam Analysis";
    preferred-width: 1080px; preferred-height: 820px;
    min-width: 760px; min-height: 300px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    in-out property <bool> dark: false;
    in-out property <bool> busy;
    in property <bool> loaded;
    in property <bool> has-results;
    in property <string> filename: "No measurement selected";
    in property <string> input-path;
    in-out property <string> output-path;
    in property <[string]> formats;
    in property <[string]> spectra;
    in-out property <int> mode;
    in-out property <int> spectrum;
    in-out property <string> first-channel: "0";
    in-out property <string> last-channel;
    in property <string> description;
    in property <string> inspection;
    in property <string> preview;
    in property <string> results;
    in property <string> warnings;
    in property <string> status: "Open an MPA measurement or list-mode file to begin.";
    in property <bool> error;
    in property <string> drop-hint;
    // List-mode (.lst) analysis panel, shown instead of the converter panel.
    in property <bool> list-mode;
    // Top-level navigation: 0 = home, 1 = convert, 2 = analyze. This only
    // decides whether the converter/list-mode panel is reachable; which
    // panel variant renders is still decided by `list-mode` alone, since a
    // loaded file's extension does not change when the screen changes.
    in-out property <int> screen: 0;
    // True once a loaded file's extension does not match the current
    // screen (e.g. a .lst file opened on the Convert screen).
    property <bool> mismatched: root.loaded && ((root.screen == 1 && root.list-mode) || (root.screen == 2 && !root.list-mode));
    callback go-home();
    callback pick-convert();
    callback pick-analyze();
    in property <[string]> roi-units;
    in-out property <[RoiRow]> rois;
    in-out property <[TimeWindowRow]> time-windows;
    in-out property <string> bin-width: "15000";
    callback add-roi();
    callback remove-roi(int);
    callback add-time-window();
    callback remove-time-window(int);
    callback analyze();
    callback open-input();
    callback input-contains(float, float) -> bool;
    input-contains(x, y) => {
        return x >= input-panel.absolute-position.x / 1px && x < (input-panel.absolute-position.x + input-panel.width) / 1px
            && y >= input-panel.absolute-position.y / 1px && y < (input-panel.absolute-position.y + input-panel.height) / 1px
            && y >= 0 && y < root.height / 1px;
    }
    callback choose-output();
    callback settings-changed();
    callback convert();
    callback open-directory();
    background: root.dark ? #151c28 : #f3f6fb;
    property <color> ink: root.dark ? #edf2fa : #17243b;
    property <color> muted: root.dark ? #b2bfd2 : #52637a;
    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    ScrollView {
      horizontal-scrollbar-policy: always-off;
      VerticalLayout {
        padding: 24px; spacing: 16px;
        HorizontalLayout {
            VerticalLayout {
                Text { text: "Moulinette"; color: root.ink; font-size: 28px; font-weight: 700; }
                Text { text: "ION BEAM ANALYSIS  /  MEASUREMENT CONVERTER"; color: root.muted; font-size: 12px; }
            }
            if root.screen != 0: Button { text: "← Home"; clicked => { root.go-home(); } }
            CheckBox { text: "Dark theme"; checked <=> root.dark; }
        }
        if root.screen == 0: HorizontalLayout {
            spacing: 16px;
            Panel {
                dark: root.dark;
                VerticalLayout {
                    padding: 24px; spacing: 12px; alignment: center;
                    Text { text: "List-mode analysis"; color: root.ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Inspect .lst list-mode acquisitions: ROI rates and violin plots."; color: root.muted; wrap: word-wrap; horizontal-alignment: center; }
                    Button { text: "Analyze"; primary: true; clicked => { root.pick-analyze(); } }
                }
            }
            Panel {
                dark: root.dark;
                VerticalLayout {
                    padding: 24px; spacing: 12px; alignment: center;
                    Text { text: "Measurement conversion"; color: root.ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Convert .mpa measurements to XY, EY and other legacy formats."; color: root.muted; wrap: word-wrap; horizontal-alignment: center; }
                    Button { text: "Convert"; primary: true; clicked => { root.pick-convert(); } }
                }
            }
        }
        // Always instantiated (never inside an `if`) so `input-contains` can
        // keep referencing it by id; collapsed to zero height and hidden
        // instead of removed when the home screen is showing.
        input-panel := Panel {
            dark: root.dark;
            visible: root.screen != 0;
            max-height: root.screen != 0 ? 100000px : 0px;
            clip: true;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                HorizontalLayout {
                    Text { text: root.filename; color: root.ink; font-weight: 600; overflow: elide; }
                    Button { text: "Open .mpa/.lst…"; enabled: !root.busy; clicked => { root.open-input(); } }
                }
                Text { text: root.drop-hint != "" ? root.drop-hint : root.busy ? "Working — file drops are unavailable." : "Drop one .mpa or .lst file here, or use Open."; color: root.muted; }
                Text { text: root.input-path; color: root.muted; overflow: elide; }
            }
        }
        if root.screen != 0 && !root.mismatched && root.list-mode: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: "List-mode inspection"; color: root.ink; font-size: 18px; font-weight: 600; }
                Text { text: "Event summary and ADC calibration from the .lst header"; color: root.muted; wrap: word-wrap; }
                TextEdit { text: root.inspection; read-only: true; min-height: 80px; max-height: 160px; }
            }
        }
        if root.screen != 0 && !root.mismatched && root.list-mode: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: "List-mode analysis"; color: root.ink; font-size: 18px; font-weight: 600; }
                Text { text: "Rate vs. time per ROI, written as CSV and PNG. Time windows add one violin plot per ROI."; color: root.muted; wrap: word-wrap; }
                Text { text: "Regions of interest · name, ADC (1–8), low and high bounds, unit"; color: root.muted; }
                for roi[index] in root.rois: HorizontalLayout {
                    spacing: 8px;
                    LineEdit { text <=> roi.name; placeholder-text: "Name"; min-width: 80px; horizontal-stretch: 2; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.adc; placeholder-text: "ADC"; min-width: 50px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.low; placeholder-text: "Low"; min-width: 60px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> roi.high; placeholder-text: "High"; min-width: 60px; horizontal-stretch: 1; enabled: !root.busy; edited => { root.settings-changed(); } }
                    ComboBox { model: root.roi-units; current-index <=> roi.unit; min-width: 90px; horizontal-stretch: 0; enabled: !root.busy; selected => { root.settings-changed(); } }
                    Button { text: "Remove"; enabled: !root.busy; clicked => { root.remove-roi(index); } }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Add ROI"; enabled: !root.busy; clicked => { root.add-roi(); } }
                }
                Text { text: "Time-bin width (ms)"; color: root.muted; }
                LineEdit { text <=> root.bin-width; enabled: !root.busy; edited => { root.settings-changed(); } }
                Text { text: "Violin time windows (s) · optional, start inclusive, end exclusive"; color: root.muted; }
                for period[index] in root.time-windows: HorizontalLayout {
                    spacing: 8px;
                    LineEdit { text <=> period.start-s; placeholder-text: "Start (s)"; min-width: 80px; enabled: !root.busy; edited => { root.settings-changed(); } }
                    LineEdit { text <=> period.end-s; placeholder-text: "End (s)"; min-width: 80px; enabled: !root.busy; edited => { root.settings-changed(); } }
                    Button { text: "Remove"; enabled: !root.busy; clicked => { root.remove-time-window(index); } }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Add time window"; enabled: !root.busy; clicked => { root.add-time-window(); } }
                }
                Text { text: "Output directory"; color: root.muted; }
                HorizontalLayout {
                    LineEdit { text <=> root.output-path; enabled: !root.busy; edited => { root.settings-changed(); } }
                    Button { text: "Browse…"; enabled: !root.busy; clicked => { root.choose-output(); } }
                }
                Text { text: "Expected files"; color: root.muted; }
                TextEdit { text: root.preview; read-only: true; min-height: 60px; }
                Text { text: "Existing files are never overwritten."; color: root.muted; font-size: 12px; }
            }
        }
        if root.screen != 0 && !root.mismatched && !root.list-mode: HorizontalLayout {
            spacing: 16px;
            Panel {
                dark: root.dark;
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Text { text: "Measurement inspection"; color: root.ink; font-size: 18px; font-weight: 600; }
                    Text { text: "Raw parser metadata · ADC follows DATA occurrence"; color: root.muted; wrap: word-wrap; }
                    TextEdit { text: root.inspection; read-only: true; }
                }
            }
            Panel {
                dark: root.dark;
                VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Text { text: "Conversion settings"; color: root.ink; font-size: 18px; font-weight: 600; }
                    Text { text: "Output format"; color: root.muted; }
                    ComboBox { model: root.formats; current-index <=> root.mode; enabled: !root.busy; selected => { root.settings-changed(); } }
                    Text { text: root.description; color: root.muted; wrap: word-wrap; }
                    Text { text: "Spectra to convert"; color: root.muted; }
                    ComboBox { model: root.spectra; current-index <=> root.spectrum; enabled: root.loaded && !root.busy; selected => { root.settings-changed(); } }
                    if root.mode != 6: HorizontalLayout {
                        VerticalLayout {
                            Text { text: "First channel (0-based)"; color: root.muted; }
                            LineEdit { text <=> root.first-channel; enabled: !root.busy; }
                        }
                        VerticalLayout {
                            Text { text: "Last channel (inclusive)"; color: root.muted; }
                            LineEdit { text <=> root.last-channel; placeholder-text: "Final channel"; enabled: !root.busy; }
                        }
                    }
                    Text { text: "Output directory"; color: root.muted; }
                    HorizontalLayout {
                        LineEdit { text <=> root.output-path; enabled: !root.busy; edited => { root.settings-changed(); } }
                        Button { text: "Browse…"; enabled: !root.busy; clicked => { root.choose-output(); } }
                    }
                    Text { text: "Expected filenames"; color: root.muted; }
                    TextEdit { text: root.preview; read-only: true; min-height: 60px; }
                    Text { text: "Existing files are never overwritten."; color: root.muted; font-size: 12px; }
                }
            }
        }
        if root.screen != 0 && !root.mismatched: Panel {
            dark: root.dark;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                HorizontalLayout {
                    Text { text: "Results"; color: root.ink; font-size: 18px; font-weight: 600; }
                    Button { text: "Open output folder"; enabled: root.has-results && !root.busy; clicked => { root.open-directory(); } }
                }
                TextEdit { text: root.results; read-only: true; min-height: 60px; max-height: 100px; }
                Text { text: root.warnings; color: root.muted; wrap: word-wrap; font-size: 12px; }
            }
        }
        if root.screen != 0: HorizontalLayout {
            spacing: 12px;
            if root.busy: Spinner { }
            Text { text: root.status; color: root.error ? (root.dark ? #ffaaaa : #a52626) : root.ink; wrap: word-wrap; }
            if !root.mismatched: Button {
                text: root.busy ? "Working…" : root.list-mode ? "Run list-mode analysis" : "Convert measurement";
                primary: true; enabled: root.loaded && !root.busy;
                clicked => { if root.list-mode { root.analyze(); } else { root.convert(); } }
            }
        }
    }
    }
}

